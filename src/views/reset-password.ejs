<%- include('partials/head') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h3 class="mb-1"><i class="bi bi-box-seam text-primary"></i> Marketplace Helper</h3>
      <p class="text-muted mb-0">Escolha uma nova senha</p>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <% if (error) { %>
          <div class="alert alert-danger py-2"><i class="bi bi-x-circle"></i> <%= error %></div>
        <% } %>

        <% if (invalidLink) { %>
          <a href="/recuperar-senha" class="btn btn-primary w-100"><i class="bi bi-envelope"></i> Pedir novo link</a>
        <% } else { %>
          <form method="post" action="/redefinir-senha">
            <input type="hidden" name="token" value="<%= token %>" />
            <div class="mb-3">
              <label class="form-label">Nova senha</label>
              <input type="password" name="newPassword" class="form-control" required autofocus minlength="8" />
              <div class="form-text">Mínimo 8 caracteres, com pelo menos uma letra maiúscula e um número.</div>
            </div>
            <div class="mb-3">
              <label class="form-label">Confirmar nova senha</label>
              <input type="password" name="confirmPassword" class="form-control" required minlength="8" />
            </div>
            <button type="submit" class="btn btn-primary w-100">
              <i class="bi bi-key"></i> Salvar nova senha
            </button>
          </form>
        <% } %>
      </div>
    </div>

    <p class="text-center text-muted mt-3 mb-0"><a href="/login">Voltar ao login</a></p>
  </div>
</div>

<%- include('partials/footer') %>
