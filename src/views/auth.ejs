<% var active = 'auth'; %>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container py-4" style="max-width: 720px;">
  <h3 class="mb-1"><i class="bi bi-shield-lock"></i> Conexão com o Mercado Livre</h3>
  <p class="text-muted mb-4">Conecte sua conta para sincronizar anúncios, preços e fretes.</p>

  <% if (message) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> <%= message %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger"><i class="bi bi-x-circle"></i> <%= error %></div>
  <% } %>

  <div class="card shadow-sm">
    <div class="card-body">
      <% if (status.status === 'active') { %>
        <h5 class="card-title"><i class="bi bi-check-circle-fill text-success"></i> Conta conectada</h5>
        <ul class="list-unstyled mb-3">
          <% if (profile && profile.nickname) { %>
            <li><strong>Usuário:</strong> <%= profile.nickname %></li>
          <% } %>
          <% if (status.mlUserId) { %>
            <li><strong>ID no Mercado Livre:</strong> <%= status.mlUserId %></li>
          <% } %>
          <% if (status.expiresAt) { %>
            <li class="text-muted small">
              Acesso válido até <%= new Date(status.expiresAt).toLocaleString('pt-BR') %> (renovado automaticamente).
            </li>
          <% } %>
        </ul>
        <form action="/ml/desconectar" method="post" onsubmit="return confirm('Desconectar a conta do Mercado Livre?');">
          <button type="submit" class="btn btn-outline-danger">
            <i class="bi bi-plug"></i> Desconectar
          </button>
        </form>

      <% } else if (status.status === 'reconnect_required') { %>
        <div class="alert alert-warning">
          <i class="bi bi-exclamation-triangle"></i>
          Sua conexão com o Mercado Livre expirou ou foi revogada. Reconecte para continuar sincronizando.
        </div>
        <a href="/ml/conectar" class="btn btn-warning fw-semibold">
          <i class="bi bi-arrow-repeat"></i> Reconectar
        </a>

      <% } else { %>
        <h5 class="card-title">Conta não conectada</h5>
        <p class="text-muted">
          Você será levado ao Mercado Livre para autorizar o acesso e volta para cá em seguida.
        </p>
        <a href="/ml/conectar" class="btn btn-warning fw-semibold">
          <i class="bi bi-box-arrow-up-right"></i> Conectar com Mercado Livre
        </a>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
