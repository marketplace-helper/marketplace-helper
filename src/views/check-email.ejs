<%- include('partials/head') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h3 class="mb-1"><i class="bi bi-box-seam text-primary"></i> Marketplace Helper</h3>
      <p class="text-muted mb-0">Confirme seu e-mail</p>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <% if (message) { %>
          <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> <%= message %></div>
        <% } %>
        <div class="alert alert-info">
          <i class="bi bi-envelope-check"></i>
          Enviamos um link de confirmação para
          <strong><%= email || 'o seu e-mail' %></strong>.
          Clique nele para ativar a conta. O link vale por 24 horas.
        </div>
        <p class="text-muted small">Não chegou? Confira a pasta de spam ou peça um novo link:</p>
        <form method="post" action="/confirmar-email/reenviar">
          <div class="mb-3">
            <label class="form-label">E-mail</label>
            <input type="email" name="email" class="form-control" value="<%= email %>" required />
          </div>
          <button type="submit" class="btn btn-outline-primary w-100">
            <i class="bi bi-arrow-repeat"></i> Reenviar link
          </button>
        </form>
      </div>
    </div>

    <p class="text-center text-muted mt-3 mb-0"><a href="/login">Voltar ao login</a></p>
  </div>
</div>

<%- include('partials/footer') %>
