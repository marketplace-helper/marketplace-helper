<%- include('partials/head') %>

<div class="auth-wrap">
  <div class="auth-card">
    <div class="text-center mb-4">
      <h3 class="mb-1"><i class="bi bi-box-seam text-primary"></i> Marketplace Helper</h3>
      <p class="text-muted mb-0"><%= texto ? texto.titulo : 'Contas' %></p>
    </div>

    <div class="card shadow-sm">
      <div class="card-body p-4">
        <% if (erro) { %>
          <div class="alert alert-warning mb-0"><i class="bi bi-exclamation-triangle"></i> <%= erro %></div>
        <% } else { %>
          <dl class="row small mb-3">
            <dt class="col-4">Loja</dt><dd class="col-8"><%= alvo.storeName %></dd>
            <dt class="col-4">E-mail</dt><dd class="col-8"><%= alvo.email %></dd>
            <dt class="col-4">WhatsApp</dt><dd class="col-8"><%= alvo.whatsapp || '—' %></dd>
            <dt class="col-4">Plano</dt><dd class="col-8"><%= alvo.plano %></dd>
          </dl>
          <% if (resultado) { %>
            <div class="alert alert-success mb-0"><i class="bi bi-check-circle"></i> <%= resultado %></div>
          <% } else { %>
            <form method="post" action="/admin/contas/acao">
              <input type="hidden" name="token" value="<%= token %>" />
              <button type="submit" class="btn <%= texto.classe %> w-100"><%= texto.botao %></button>
            </form>
          <% } %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
