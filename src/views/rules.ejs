<% var active = 'rules'; %>
<%- include('partials/head') %>
<%- include('partials/nav') %>

<div class="container py-4" style="max-width: 720px;">
  <h3 class="mb-1"><i class="bi bi-sliders"></i> Regras de Negócio</h3>
  <p class="text-muted mb-4">
    Impostos e custos usados nos cálculos. Os valores são em <strong>porcentagem (%)</strong>.
  </p>

  <% if (message) { %>
    <div class="alert alert-success"><i class="bi bi-check-circle"></i> <%= message %></div>
  <% } %>

  <form action="/regras" method="post">
    <div class="card shadow-sm">
      <div class="card-body">
        <div class="row g-4">
          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold" for="regime">Regime tributário</label>
            <select id="regime" name="regime" class="form-select">
              <% REGIMES.forEach(function (r) { %>
                <option value="<%= r %>" <%= regime === r ? 'selected' : '' %>><%= REGIME_LABEL[r] %></option>
              <% }); %>
            </select>
            <small class="text-muted">Define PIS/Cofins hoje e CBS/IBS a partir de 2027.</small>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold" for="ufOrigem">UF de origem</label>
            <select id="ufOrigem" name="ufOrigem" class="form-select">
              <option value="">—</option>
              <% UFS.forEach(function (u) { %>
                <option value="<%= u %>" <%= rules.ufOrigem === u ? 'selected' : '' %>><%= u %></option>
              <% }); %>
            </select>
            <small class="text-muted">Estado de onde as vendas saem.</small>
          </div>

          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="creditoCompra" name="creditoCompra" value="1"
                     <%= rules.creditoCompra ? 'checked' : '' %> <%= regime === 'SIMPLES' ? 'disabled' : '' %> />
              <label class="form-check-label" for="creditoCompra">
                Considerar crédito de PIS/Cofins/CBS/IBS na compra
              </label>
            </div>
            <small class="text-muted">
              Abate o imposto pago na compra (custo do produto × alíquota) dos tributos não cumulativos.
              Não se aplica ao Simples Nacional.
            </small>
          </div>

          <% if (regime === 'PRESUMIDO' || regime === 'REAL') { %>
            <div class="col-12">
              <div class="alert alert-warning small mb-0">
                <i class="bi bi-exclamation-triangle"></i>
                PIS/Cofins agora são calculados automaticamente. Se você os somou no ICMS ou no Custo operacional, retire-os de lá para não contar em dobro.
              </div>
            </div>
          <% } %>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">ICMS</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" name="icms" id="icms" class="form-control"
                     value="<%= rules.icms %>" placeholder="0,00" />
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Alíquota de ICMS da venda.</small>
            <small class="text-muted d-block" id="icmsDica" hidden></small>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">IPI</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" name="ipi" class="form-control"
                     value="<%= rules.ipi %>" placeholder="0,00" />
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Imposto sobre Produtos Industrializados.</small>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">DIFAL</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" name="difal" class="form-control"
                     value="<%= rules.difal %>" placeholder="0,00" />
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Diferencial de alíquota interestadual.</small>
          </div>

          <div class="col-12 col-md-6">
            <label class="form-label fw-semibold">Custo Operacional</label>
            <div class="input-group">
              <input type="number" step="0.01" min="0" name="custoOperacional" class="form-control"
                     value="<%= rules.custoOperacional %>" placeholder="0,00" />
              <span class="input-group-text">%</span>
            </div>
            <small class="text-muted">Custo operacional sobre a venda.</small>
          </div>
        </div>
      </div>
      <div class="card-footer bg-white d-flex justify-content-between align-items-center">
        <small class="text-muted">
          Última atualização: <%= new Date(rules.updatedAt).toLocaleString('pt-BR') %>
        </small>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-save"></i> Salvar regras
        </button>
      </div>
    </div>
  </form>
  <script>
    (function () {
      var regime = document.getElementById('regime');
      var credito = document.getElementById('creditoCompra');
      var uf = document.getElementById('ufOrigem');
      var icms = document.getElementById('icms');
      var dica = document.getElementById('icmsDica');
      // Alíquota interna modal de cada UF (tabela de alíquotas). Só Presumido e Real:
      // no Simples (e no híbrido) o ICMS está dentro do DAS.
      var INTERNO = <%- JSON.stringify(icmsInternoPorUf) %>;
      function sugerido() {
        var usa = regime.value === 'PRESUMIDO' || regime.value === 'REAL';
        return usa && Object.prototype.hasOwnProperty.call(INTERNO, uf.value) ? INTERNO[uf.value] : null;
      }
      function atualizaDica() {
        var p = sugerido();
        dica.hidden = p == null;
        if (p != null) {
          dica.textContent = 'Alíquota interna de ' + uf.value + ': ' + String(p).replace('.', ',') +
            '% (venda dentro do estado; venda para outro estado costuma ter 4%, 7% ou 12%).';
        }
      }
      uf.addEventListener('change', function () {
        var p = sugerido();
        if (p != null) icms.value = p;
        atualizaDica();
      });
      regime.addEventListener('change', function () {
        credito.disabled = regime.value === 'SIMPLES';
        if (credito.disabled) credito.checked = false;
        var p = sugerido();
        if (p != null && (icms.value === '' || Number(icms.value) === 0)) icms.value = p;
        atualizaDica();
      });
      atualizaDica();
    })();
  </script>

  <!-- Alíquotas da tabela que valem hoje para o regime/UF escolhidos -->
  <div class="card shadow-sm mt-4">
    <div class="card-header bg-white fw-semibold">
      <i class="bi bi-percent"></i> Alíquotas aplicadas hoje (<%= REGIME_LABEL[regime] %>)
    </div>
    <div class="card-body">
      <table class="table table-sm mb-0" style="font-size: 0.85rem;">
        <thead><tr><th>Tributo</th><th class="text-end">Alíquota</th><th>Observação</th></tr></thead>
        <tbody>
          <% aliquotas.forEach(function (a) { %>
            <tr>
              <td><%= a.tributo %></td>
              <td class="text-end">
                <%= a.tipo === 'FATOR' ? ('× ' + a.aliquota + ' sobre o ICMS digitado') : (a.aliquota + '%') %>
              </td>
              <td>
                <% if (a.somenteDestaque) { %><span class="badge text-bg-light">só destaque</span><% } %>
                <% if (a.naoCumulativo) { %><span class="badge text-bg-light">não cumulativo</span><% } %>
                <% if (a.observacao && a.observacao.indexOf('Estimativa') === 0) { %><span class="badge text-bg-warning">estimativa</span><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Seção explicativa do cálculo -->
  <div class="card shadow-sm mt-4">
    <div class="card-header bg-white fw-semibold">
      <i class="bi bi-calculator"></i> Como o cálculo financeiro é feito
    </div>
    <div class="card-body">
      <p class="text-muted">
        Na tela de <strong>Anúncios</strong>, cada item mostra <strong>Lucro Líquido</strong> e
        <strong>Margem</strong>, calculados assim:
      </p>

      <ol class="mb-4">
        <li class="mb-2">
          <strong>Base de venda</strong> — usamos o <strong>Preço Por</strong> (preço promocional).
          Se o anúncio não estiver em promoção, usamos o <strong>Preço De</strong>.
        </li>
        <li class="mb-2">
          <strong>Impostos</strong> — aplicamos sobre a base de venda as alíquotas que você cadastra aqui
          (ICMS + IPI + DIFAL + Custo Operacional) e, conforme o regime, PIS/Cofins (até 2026) e CBS/IBS
          (a partir de 2027). O ICMS é reduzido gradualmente de 2029 a 2032 e deixa de existir em 2033.
        </li>
        <li class="mb-2">
          <strong>Lucro Líquido</strong> = Base − Custo do produto − Comissão do ML − Frete − Impostos.
        </li>
        <li>
          <strong>Margem</strong> = Lucro Líquido ÷ Base × 100.
        </li>
      </ol>

      <div class="bg-light rounded p-3 mb-4" style="font-family: ui-monospace, monospace; font-size: 0.85rem;">
        Lucro = Base − Custo − Comissão − Frete − Impostos<br />
        Margem&nbsp;% = (Lucro ÷ Base) × 100
      </div>

      <h6 class="fw-semibold mb-2"><i class="bi bi-lightbulb text-warning"></i> Exemplo (com as suas regras atuais)</h6>
      <p class="text-muted small mb-2">
        Produto de exemplo: preço de venda R$ <%= exemplo.precoPor.toFixed(2) %>,
        custo R$ <%= exemplo.custoProduto.toFixed(2) %>, comissão R$ <%= exemplo.comissao.toFixed(2) %>,
        frete R$ <%= exemplo.frete.toFixed(2) %>.
      </p>

      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0" style="font-size: 0.85rem;">
          <thead>
            <tr>
              <th></th>
              <% exemplos.forEach(function (e) { %><th class="text-end"><%= e.ano || 'Hoje' %></th><% }); %>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Base de venda</td>
              <% exemplos.forEach(function (e) { %><td class="text-end">R$ <%= e.base.toFixed(2) %></td><% }); %>
            </tr>
            <tr class="text-danger">
              <td>(−) Custo + Comissão + Frete</td>
              <% exemplos.forEach(function (e) { %><td class="text-end">− R$ <%= (exemplo.custoProduto + e.custoML).toFixed(2) %></td><% }); %>
            </tr>
            <% ['ICMS', 'IPI', 'DIFAL', 'CUSTO_OPERACIONAL', 'PIS', 'COFINS', 'CBS', 'IBS'].forEach(function (t) {
                 var algum = exemplos.some(function (e) { return e.tributos.linhas.some(function (l) { return l.tributo === t && (l.devido > 0 || l.somenteDestaque); }); });
                 if (!algum) return; %>
              <tr class="text-danger small">
                <td class="ps-3">(−) <%= t === 'CUSTO_OPERACIONAL' ? 'Custo operacional' : t %></td>
                <% exemplos.forEach(function (e) {
                     var l = e.tributos.linhas.find(function (x) { return x.tributo === t; }); %>
                  <td class="text-end">
                    <% if (!l) { %>—<% } else if (l.somenteDestaque) { %><span class="text-muted">só destaque</span><% } else { %>− R$ <%= l.devido.toFixed(2) %><%= l.estimativa ? '*' : '' %><% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
            <tr class="border-top">
              <td class="fw-semibold">= Lucro Líquido</td>
              <% exemplos.forEach(function (e) { %>
                <td class="text-end fw-bold <%= e.lucro >= 0 ? 'text-success' : 'text-danger' %>">R$ <%= e.lucro.toFixed(2) %></td>
              <% }); %>
            </tr>
            <tr>
              <td class="fw-semibold">Margem</td>
              <% exemplos.forEach(function (e) { %>
                <td class="text-end">
                  <span class="badge <%= e.margem >= 0 ? 'text-bg-success' : 'text-bg-danger' %>"><%= e.margem.toFixed(1) %>%</span>
                </td>
              <% }); %>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="text-muted small mt-2 mb-0">
        * Alíquota estimada: a de referência ainda não foi fixada. Anos futuros são simulações — confira com seu contador.
      </p>

      <% if (exemplos[0].impostos === 0) { %>
        <p class="text-muted small mt-3 mb-0">
          <i class="bi bi-info-circle"></i>
          Suas alíquotas estão zeradas, por isso os impostos de hoje ficaram em R$ 0,00 no exemplo.
          Preencha os campos acima para vê-los no cálculo.
        </p>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
