generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Usuario da aplicacao (cada loja tem a sua conta)
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  storeName    String
  whatsapp     String?
  passwordHash String
  createdAt    DateTime @default(now())
  // Preenchido quando o usuário confirma o e-mail. Login bloqueado enquanto for null.
  emailVerifiedAt DateTime?
  // Novo e-mail aguardando confirmação (troca em "Minha conta"). O e-mail atual
  // continua valendo até o usuário clicar no link enviado para este endereço.
  pendingEmail    String?

  mlConnection MlConnection?
  mlAttempts   MlOAuthAttempt[]
  settings     Settings?
  businessRule BusinessRule?
  items        Item[]
  authTokens   AuthToken[]
}

// Tokens de uso único enviados por e-mail (confirmação de cadastro e recuperação de senha).
// Guardamos só o hash SHA-256; o token puro existe apenas no link do e-mail.
model AuthToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "VERIFY" | "RESET" | "EMAIL_CHANGE"
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

// Conexao OAuth do usuario com o Mercado Livre (app unico da plataforma)
model MlConnection {
  id            Int       @id @default(autoincrement())
  userId        Int       @unique
  mlUserId      String?   @unique
  accessToken   String?
  refreshToken  String?
  expiresAt     DateTime?
  // "active" | "reconnect_required" | "disconnected"
  status        String    @default("disconnected")
  lastRefreshAt DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
}

// Tentativa de autorizacao OAuth em andamento (state/PKCE), de uso unico
model MlOAuthAttempt {
  id           Int       @id @default(autoincrement())
  nonce        String    @unique
  userId       Int
  codeVerifier String
  client       String    // "web" | "mobile"
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Configuracoes por usuario
model Settings {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique
  zipCode    String    @default("01001000")
  lastSyncAt DateTime?
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Regras de negocio por usuario (valores em %)
model BusinessRule {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  icms             Float    @default(0)
  ipi              Float    @default(0)
  difal            Float    @default(0)
  custoOperacional Float    @default(0)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Anuncios do Mercado Livre (por usuario)
model Item {
  id            Int      @id @default(autoincrement())
  userId        Int
  mlb           String
  proprio       Boolean  @default(true)
  variacaoIds   String?
  sku           String?
  variacaoSkus  String?
  marca         String?
  titulo        String   @default("")
  largura       Float?
  altura        Float?
  comprimento   Float?
  pesoReal      Float?
  thumbnail     String?
  permalink     String?
  custoProduto  Float?
  precoDe       Float    @default(0)
  precoPor      Float    @default(0)
  frete         Float?
  freteAnterior Float?
  freteMudou    Boolean  @default(false)
  comissao      Float?
  comissaoPct   Float?
  status        String?
  dataCriacao   String?
  tipoAnuncio   String?
  visitas       Int      @default(0)
  vendas        Int      @default(0)
  estoque       Int      @default(0)
  catalogo      Boolean  @default(false)
  full          Boolean  @default(false)
  categoria1    String?
  categoria2    String?
  categoria3    String?
  categoria4    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingHistory ShippingHistory[]

  @@unique([userId, mlb])
  @@index([userId])
  @@index([titulo])
  @@index([frete])
}

// Historico de fretes para detectar mudancas ao longo do tempo
model ShippingHistory {
  id         Int      @id @default(autoincrement())
  itemId     Int
  mlb        String
  cost       Float
  capturedAt DateTime @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([mlb])
  @@index([capturedAt])
}
