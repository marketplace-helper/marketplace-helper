# Servidor
PORT=3333

# Segredo da sessao (cookie de login) - gere um valor aleatorio proprio
SESSION_SECRET=troque-por-um-valor-aleatorio

# Segredo dos tokens JWT da API (/api). Opcional: se vazio, usa o SESSION_SECRET.
JWT_SECRET=troque-por-um-valor-aleatorio

# Chave de criptografia dos dados sensiveis do ML no banco (32 bytes em hex).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=troque-por-uma-chave-hex-de-64-caracteres

# Banco (Postgres). Local: suba com "npm run db:up" (docker-compose.yml).
# No Railway: referencie a variavel do servico Postgres, ex.: ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://mh:mh@localhost:5432/marketplace_helper?schema=public"

# Ambiente. Em producao (servidor/Railway) use "production": ativa cookie Secure,
# trust proxy e exige SESSION_SECRET/ENCRYPTION_KEY. Localmente, deixe comentado.
# NODE_ENV=production

# Fuso do agendamento da sincronizacao (padrao America/Sao_Paulo)
# TZ=America/Sao_Paulo

# URL pública do app, usada nos links dos e-mails (sem barra no final).
# Em produção: APP_URL=https://marketplace-helper.up.railway.app
APP_URL=http://localhost:3333

# E-mail (Resend). Use uma chave "sending access" criada em resend.com/api-keys.
# Rodando local, pode deixar vazia: os e-mails (com os links) aparecem no terminal.
# Para liberar uma conta sem e-mail: npm run conta:liberar -- seu@email.com
RESEND_API_KEY=
# Sem domínio verificado, use onboarding@resend.dev: só entrega para o e-mail
# dono da conta Resend. Com domínio: Marketplace Helper <nao-responda@mail.seudominio.com.br>
MAIL_FROM=Marketplace Helper <onboarding@resend.dev>

# App do Mercado Livre da plataforma (developers.mercadolivre.com.br). Um único app
# para todos os usuários, que conectam a conta por OAuth.
ML_APP_ID=
ML_APP_SECRET=
# Callback cadastrado no app ML (padrão: APP_URL + /api/ml/oauth/callback)
# ML_REDIRECT_URI=http://localhost:3333/api/ml/oauth/callback
# Produção: ML_REDIRECT_URI=https://app.marketplacehelper.com.br/api/ml/oauth/callback
# Deep link do app mobile para o retorno do OAuth
# MOBILE_OAUTH_REDIRECT=marketplacehelper://ml/oauth
