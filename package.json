{
  "name": "dashboard-ml",
  "version": "1.0.0",
  "description": "Relatorios e dashboards dos anuncios do Mercado Livre",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "prisma migrate deploy && node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1179.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "onnxruntime-node": "^1.31.1",
    "prisma": "^6.2.1",
    "resend": "^6.38.0",
    "sqlite": "^5.1.1",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.12.0": true,
    "@scarf/scarf@1.4.0": true,
    "onnxruntime-node@1.31.1": true,
    "prisma@6.12.0": true
  }
}
