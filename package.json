{
  "name": "dashboard-ml",
  "version": "1.0.0",
  "description": "Relatorios e dashboards dos anuncios do Mercado Livre",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:prod": "prisma migrate deploy && node prisma/seed/aliquotas.js && node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "conta:liberar": "node scripts/liberar-conta.js",
    "mock:anuncios": "node scripts/mock-anuncios.js",
    "seed:aliquotas": "node prisma/seed/aliquotas.js",
    "db:migrar-sqlite": "node scripts/sqlite-para-postgres.js"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "prisma": "^6.2.1",
    "resend": "^6.38.0",
    "swagger-ui-express": "^5.0.1"
  },
  "engines": {
    "node": ">=20"
  }
}
